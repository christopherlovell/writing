---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import Base from '../layouts/Base.astro';
import { getPosts } from '../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { title, description, date, updated, draft } = post.data;
const { Content } = await render(post);
---

<Base title={title} description={description}>
  <article class="post">
    <header class="post-header">
      <p class="margin-label"><FormattedDate date={date} /></p>
      <h1>{title}</h1>
      <p class="standfirst">{description}</p>
      {draft && <p class="draft-flag">Draft: hidden from the published site.</p>}
    </header>
    <div class="prose">
      <Content />
    </div>
    {
      updated && (
        <p class="updated">
          Updated <FormattedDate date={updated} />
        </p>
      )
    }
  </article>
</Base>
